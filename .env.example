# Existing authenticated Codex OAuth Proxy. The web app never stores OAuth tokens.
VIRAL_CODEX_PROXY_BASE_URL=http://127.0.0.1:4348
VIRAL_CODEX_PROXY_CALLER_ID=viral
VIRAL_CODEX_PROXY_SECRET_FILE=/absolute/path/to/viral-codex-proxy.secret
VIRAL_CODEX_PROXY_TIMEOUT_MS=90000
VIRAL_CODEX_PROXY_MAX_OUTPUT_CHARS=16000
